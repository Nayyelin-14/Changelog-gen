AZURE_DEVOPS_PAT=your-pat
AZURE_DEVOPS_ORG=datasabai
GITHUB_TOKEN=your-github-pat
GITHUB_OWNER=your-github-org-or-user
AI_API_KEY=your-ai-key
AI_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
AI_MODEL=meta/llama-3.2-11b-vision-instruct

# Extra AI providers beyond NVIDIA (all OpenAI-compatible chat endpoints). Each provider block
# needs its own base URL + shared admin API key; a provider without an API key is hidden from the
# UI. `model`, `fallback-models` (comma list), and `prompt.<developer|qa|business>` are optional
# per provider — omit to use the same defaults as NVIDIA.
#
# Google Gemini (free tier, OpenAI-compatible endpoint):
#   AI_PROVIDERS=gemini
#   AI_PROVIDERS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
#   AI_PROVIDERS_GEMINI_API_KEY=your-gemini-key
#   AI_PROVIDERS_GEMINI_MODEL=gemini-2.5-flash
#   AI_PROVIDERS_GEMINI_FALLBACK_MODELS=gemini-2.5-pro
#   AI_PROVIDERS_GEMINI_PROMPT_DEVELOPER=
#   AI_PROVIDERS_GEMINI_PROMPT_QA=
#   AI_PROVIDERS_GEMINI_PROMPT_BUSINESS=
#
# Groq (very fast free tier):
#   AI_PROVIDERS=gemini,groq
#   AI_PROVIDERS_GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions
#   AI_PROVIDERS_GROQ_API_KEY=your-groq-key
#   AI_PROVIDERS_GROQ_MODEL=llama-3.3-70b-versatile
#
# OpenRouter / Together AI work the same way with their own base URLs + `:free` models.
# You can also point any provider block above at NVIDIA itself with the same key to test the
# multi-provider plumbing without new accounts.
DB_USERNAME=neondb_owner
DB_PASSWORD=your-db-password
DB_URL=jdbc:postgresql://your-project-pooler.region.aws.neon.tech/neondb?sslmode=require
PIPELINE_API_KEYS=your-pipeline-key

# GitHub OAuth — lets each user sign in with their own GitHub account (instead of the
# service account GITHUB_TOKEN above). Leave blank to keep the old single-account behavior.
# 1) Register an OAuth App at https://github.com/settings/developers with the callback URL:
#    https://<your-domain>/api/auth/github/callback
# 2) Set GITHUB_OAUTH_CLIENT_ID + GITHUB_OAUTH_CLIENT_SECRET from that app.
# 3) Set GITHUB_OAUTH_REDIRECT_URI to the same callback URL, GITHUB_OAUTH_APP_BASE to the site
#    origin (e.g. https://changelog-gen.duckdns.org).
# 4) AUTH_SESSION_SECRET: any long random string (used to encrypt stored OAuth tokens at rest).
#    Generate one with:  openssl rand -hex 32
# 5) AUTH_COOKIE_SECURE=true in production (false only when testing against plain HTTP locally).
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=https://changelog-gen.duckdns.org/api/auth/github/callback
GITHUB_OAUTH_APP_BASE=https://changelog-gen.duckdns.org
AUTH_SESSION_SECRET=
AUTH_COOKIE_SECURE=true

# ---------------------------------------------------------------------------
# VM `.env` extras (next to docker-compose.prod.yml — NOT the same file as this one).
# ---------------------------------------------------------------------------
# DOMAIN -> public hostname for the changelog service (used by Caddy for HTTPS), e.g. changelog.example.com

# ---------------------------------------------------------------------------
# GitHub Actions secrets (repo Settings > Secrets and variables > Actions).
# These are NOT read from .env by the service — they are configured per workflow.
# ---------------------------------------------------------------------------
# CHANGELOG_SERVICE_URL  -> the service's public base, e.g. https://<your-vm> or https://<vm>/api
#                          (the dev changelog script appends /github/pipeline/generate)
# CHANGELOG_API_KEY      -> one of PIPELINE_API_KEYS above (Bearer auth for /api/github/pipeline/generate)
# GIT_PUSH_PAT           -> PAT with repo contents:write to commit CHANGELOG.md/release to dev/main
# VM_HOST, VM_USER, VM_COMPOSE_DIR, SSH_PRIVATE_KEY -> production VM + ssh key
# VM_GHCR_USER, VM_GHCR_TOKEN                       -> optional; GHCR login on the VM (private image)
